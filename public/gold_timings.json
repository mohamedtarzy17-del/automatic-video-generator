        "start_sec": 29.317,
        "end_sec": 33.839,
        "start_frame": 880,
        "end_frame": 1015,
        "duration_frames": 135,
        "text": "It is a tangible store of value that exists outside the banking system."
    },
    {
        "index": 10,
        "start_sec": 34.28,
        "end_sec": 41.163,
        "start_frame": 1028,
        "end_frame": 1235,
        "duration_frames": 207,
