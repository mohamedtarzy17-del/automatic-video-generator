{
  "name": "automatic-video-generator",
  "version": "1.0.0",
  "description": "Automatic Video Generator – Programmatic AI Video Engine & Motion Studio built with Remotion, React, Python TTS & WhisperX.",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnvictorpaul95/automatic-video-generator.git"
  },
  "keywords": [
    "automatic-video-generator",
    "remotion",
    "ai-video",
    "motion-graphics",
    "react",
    "whisperx",
    "text-to-speech",
    "typescript",
    "video-generator",
    "programmatic-video",
    "documentary-engine"
  ],
  "license": "MIT",
  "private": false,
  "dependencies": {
    "@google-cloud/text-to-speech": "4.2.1",
    "@remotion/bundler": "4.0.463",
    "@remotion/cli": "4.0.463",
    "@remotion/media-utils": "4.0.463",
    "@remotion/renderer": "4.0.463",
    "@remotion/zod-types": "4.0.463",
    "@types/cors": "2.8.13",
    "@types/express": "4.17.13",
    "cors": "2.8.5",
    "dotenv": "17.3.1",
    "express": "4.21.0",
    "firebase": "9.19.1",
    "md5": "2.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.463",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.463",
    "@types/md5": "2.3.0",
    "@types/node": "20.12.14",
    "@types/react": "19.2.7",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tsx": "4.19.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "tsx src/studio.ts",
    "build": "tsx src/render.ts",
    "upgrade": "remotion upgrade",
    "render-cartoon": "remotion render PureCartoonExplainer rendered/cartoon_story.mp4 --overwrite",
    "render-documentary": "remotion render USDebtUltra rendered/us_debt_documentary.mp4 --overwrite",
    "render-tech": "remotion render NvidiaExplainer rendered/nvidia_tech_explainer.mp4 --overwrite",
    "render-ppt": "remotion render PPTVideoPremium rendered/presentation_video.mp4 --overwrite",
    "render-iran": "remotion render IranNuclearTalks rendered/iran_nuclear_talks_premium_v3.mp4 --overwrite",
    "lint": "eslint src && tsc"
  }
}